rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Contenido del sitio: lectura publica, escritura solo del admin.
    match /site/content {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'luammartin2001@gmail.com';
    }
    // Todo lo demas, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
