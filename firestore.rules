rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'luammartin2001@gmail.com';
    }

    // Contenido del sitio: lectura publica, escritura solo del admin.
    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Datos privados del panel (token de GitHub): solo el admin.
    match /private/github {
      allow read, write: if isAdmin();
    }

    // Todo lo demas, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
